# Sends /api and /socket.io to the backend and everything else to the app, with automatic HTTPS.
# TR: /api ve /socket.io isteklerini backend'e, geri kalanını uygulamaya gönderir; HTTPS otomatiktir.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /socket.io/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
