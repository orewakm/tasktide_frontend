# Copy to deploy/.env on the server and fill in real values.
# Point the domain's DNS A record at the VDS before starting, so Caddy can get the certificate.
DOMAIN=tasktide.example.com

DB_USER=tasktide
DB_PASSWORD=change-me
DB_NAME=tasktide

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-too
