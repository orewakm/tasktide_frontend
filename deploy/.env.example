# Copy to deploy/.env on the VDS; point the domain's DNS A record at the server first.
# TR: Sunucuda deploy/.env olarak kopyalayın; önce alan adının DNS A kaydını sunucuya yönlendirin.
DOMAIN=tasktide.example.com

DB_USER=tasktide
DB_PASSWORD=change-me
DB_NAME=tasktide

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-too
